# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/tiffin_service

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Authentication Secrets (for later phases)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Cloudinary Configuration (optional for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Configuration & Seed
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@tiffinservice.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_REGISTRATION_SECRET=your_admin_registration_secret
